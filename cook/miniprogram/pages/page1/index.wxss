/* 页面头部样式 */
.header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
  }
  
  /* logo容器样式 */
  .cover {
    margin-bottom: 20px;
  }
  
  /* logo图片样式 */
  .logo {
    width: 250px; /* logo宽度 */
    height: 250px; /* logo高度 */
  }
  
  /* 标题样式 */
  .title {
    font-size: 20px;
    font-weight: bold;
    text-align: center;
  }
  
  .button-container {
    display: flex;
    justify-content: space-between;
  }

  .button-item {
    width: 48%; /* 两个按钮平分宽度，各占48%，留出2%间隙 */
    height: 150rpx;
    background-color: #2dd60c; /* 背景，可调整 */
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 50rpx;
    border-radius: 35rpx;
  }
  
  /* 鼠标悬停时按钮样式 */
  .button-item-hover {
    background-color: #7ae06b; /* 悬停时颜色变深 */
  }