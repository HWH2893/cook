<view class="search-page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-container">
      <icon type="search" size="16" class="search-icon"></icon>
      <input 
        type="text" 
        placeholder="请输入搜索关键词" 
        placeholder-class="placeholder"
        bindinput="handleInput"
        bindconfirm="handleSearch"
        confirm-type="search"
        value="{{searchValue}}"
        class="search-input"
      />
      <icon 
        type="clear" 
        size="16" 
        class="clear-icon" 
        wx:if="{{searchValue.length > 0}}"
        bindtap="clearInput"
      ></icon>
    </view>
    <view class="search-btn" bindtap="handleSearch">搜索</view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-search" wx:if="{{showHotSearch}}">
    <view class="section-title">热门搜索</view>
    <view class="hot-tags">
      <block wx:for="{{hotSearchList}}" wx:key="*this">
        <view class="tag" bindtap="handleTagTap" data-keyword="{{item}}">{{item}}</view>
      </block>
    </view>
  </view>

  <!-- 历史搜索 -->
  <view class="history-search" wx:if="{{showHistorySearch && historySearchList.length > 0}}">
    <view class="section-title">
      <text>历史搜索</text>
      <icon type="delete" size="16" bindtap="clearHistory"></icon>
    </view>
    <view class="history-tags">
      <block wx:for="{{historySearchList}}" wx:key="*this">
        <view class="tag" bindtap="handleTagTap" data-keyword="{{item}}">{{item}}</view>
      </block>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-result" wx:if="{{showSearchResult}}">
    <view class="result-count">共找到{{resultList.length}}条结果</view>
    <scroll-view scroll-y class="result-list">
      <block wx:for="{{resultList}}" wx:key="id">
        <view class="result-item" bindtap="navigateToDetail" data-id="{{item.id}}">
          <view class="item-title">{{item.title}}</view>
          <view class="item-desc">{{item.desc}}</view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 无结果提示 -->
  <view class="empty-result" wx:if="{{showEmptyResult}}">
    <image src="/images/empty.png" mode="aspectFit"></image>
    <view class="empty-text">没有找到相关结果</view>
  </view>
</view>