/* 页面容器 */
.search-page {
  padding: 15rpx 30rpx;
  min-height: 100vh;
  background-color: #f8f8f8;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.search-input-container {
  flex: 1;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  margin-right: 15rpx;
  color: #999;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.placeholder {
  color: #ccc;
}

.clear-icon {
  margin-left: 15rpx;
  color: #999;
}

.search-btn {
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #333;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* 热门搜索和历史搜索 */
.section-title {
  font-size: 28rpx;
  color: #666;
  margin: 30rpx 0 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-tags, .history-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 12rpx 24rpx;
  background-color: #f0f0f0;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #333;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

/* 搜索结果 */
.search-result {
  margin-top: 30rpx;
}

.result-count {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.result-list {
  max-height: calc(100vh - 250rpx);
}

.result-item {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.item-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 无结果提示 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 100rpx;
}

.empty-result image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}